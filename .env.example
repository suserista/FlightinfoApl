# Copy this file to .env (or just export the variable in your shell).
# Get a key at https://developer.swedavia.se → FlightInfo API → subscribe.
#
# Linux/macOS:
#   export SWEDAVIA_API_KEY="your-key-here"
#   python airport.py
#
# Windows (PowerShell):
#   $env:SWEDAVIA_API_KEY="your-key-here"
#   python airport.py
#
# Without this variable the app automatically runs in offline mode
# using the bundled mock_flights.json sample data.

SWEDAVIA_API_KEY=your-key-here
